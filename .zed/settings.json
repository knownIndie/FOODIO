{
  "languages": {
    "TypeScript": {
      "language_servers": [
        "typescript-language-server",
        "!vtsls",
        "!eslint",
        "!biome",
        "oxlint",
        "oxfmt",
        "...",
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt",
        },
      },
      "prettier": {
        "allowed": false,
      },
      "format_on_save": "on",
    },
    "TSX": {
      "language_servers": [
        "typescript-language-server",
        "!vtsls",
        "!eslint",
        "!biome",
        "oxlint",
        "oxfmt",
        "...",
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt",
        },
      },
      "prettier": {
        "allowed": false,
      },
      "format_on_save": "on",
    },
  },
}
