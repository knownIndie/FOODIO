{
  "name": "foodio",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun next dev",
    "dev:webpack": "bun --bun next dev --webpack",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "biome check .",
    "typecheck": "bun --bun tsc --noEmit",
    "b": "bun run build",
    "s": "bun run start",
    "l": "bun run lint",
    "mc": "bun run check",
    "f": "bun run format",
    "typec": "bun run typecheck",
    "dbg": "bun run db:generate",
    "dbm": "bun run db:migrate",
    "dbp": "bun run db:push",
    "dbs": "bun run db:studio",
    "check": "bun run typecheck && bun run lint",
    "format": "biome check --write .",
    "test:seed": "bun run scripts/Script/SeedFor1000restaurants/1000-restaurants-seed.check.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:push": "bun --bun drizzle-kit push",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:check": "bun --bun drizzle-kit check"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-form": "^1.33.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "jose": "^6.2.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "mailtrap": "^4.8.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "1.0.0-rc.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "trustedDependencies": [
    "argon2",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
